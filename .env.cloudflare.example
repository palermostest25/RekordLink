# Public hostname configured on the Cloudflare Tunnel. Do not add a port.
REKORDLINK_PUBLIC_ENDPOINT=https://rekordlink.zeusyboy.com

# File containing only the secret token copied from the Tunnel setup screen.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.cloudflare-tunnel-token

REKORDLINK_VERSION=0.4.5
REKORDLINK_METADATA_ONLY=false
REKORDLINK_LOG_INVITE=false
