# Use the relay server's Tailscale/WireGuard address for both values whenever
# possible. For a public deployment, use a DNS name for ADVERTISE and 0.0.0.0
# for BIND_IP, then restrict TCP 9777 with the host firewall.
REKORDLINK_ADVERTISE=100.100.20.30
REKORDLINK_BIND_IP=100.100.20.30
REKORDLINK_VERSION=0.4.5
REKORDLINK_METADATA_ONLY=false
REKORDLINK_LOG_INVITE=false
